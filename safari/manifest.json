{
  "manifest_version": 3,
  "name": "Sarashina 翻訳 (Safari)",
  "version": "1.5.1",
  "description": "Sarashina AI 公式Translate APIを活用したSafari用高精度AI翻訳拡張機能。選択テキスト翻訳・ポップアップ翻訳・Webサイト全体翻訳に対応。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sarashina 翻訳",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "commands": {
    "sarashina-translate-selection": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Sarashinaで選択部分を翻訳"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["selection-replacement.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
