{
  "manifest_version": 3,
  "name": "Sarashina API 翻訳（非公式）",
  "version": "1.10.0",
  "description": "Sarashina APIを利用する個人開発の非公式拡張機能です。SB Intuitions株式会社の提供・公認製品ではありません。選択テキスト翻訳・解説・ページ全体翻訳・英語と日本語の読み表示に対応。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sarashina API 翻訳（非公式）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "sarashina-translate-selection": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Sarashinaで選択部分を翻訳"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "selection-replacement.js",
        "reading.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}
